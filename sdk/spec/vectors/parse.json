{
  "description": "parse_payload(payload) -> {phone, name, event_raw, page_url, extra}. Generated from the backend.",
  "cases": [
    {
      "name": "parse_0",
      "payload": {
        "phone": "9876543210",
        "name": "Asha Rao",
        "event": "purchase",
        "page_url": "https://x.com/p"
      },
      "expected": {
        "phone": "9876543210",
        "name": "Asha Rao",
        "event_raw": "purchase",
        "page_url": "https://x.com/p",
        "extra": {}
      }
    },
    {
      "name": "parse_1",
      "payload": {
        "Mobile Number": "x",
        "mobile_number": "9876543210",
        "Your_Name": "  Asha  ",
        "type": "signup"
      },
      "expected": {
        "phone": "9876543210",
        "name": "Asha",
        "event_raw": "signup",
        "page_url": "",
        "extra": {
          "mobile number": "x"
        }
      }
    },
    {
      "name": "parse_2",
      "payload": {
        "whatsapp": "9876543210",
        "first_name": "Asha",
        "last_name": "Rao",
        "city": "Pune",
        "Plan": "Gold"
      },
      "expected": {
        "phone": "9876543210",
        "name": "Asha Rao",
        "event_raw": "",
        "page_url": "",
        "extra": {
          "city": "Pune",
          "plan": "Gold"
        }
      }
    },
    {
      "name": "parse_3",
      "payload": {
        "contact": "9876543210",
        "first_name": "Asha",
        "_hidden": "x",
        "empty": "",
        "nested": {
          "a": 1
        },
        "list": [
          1
        ],
        "n": 5
      },
      "expected": {
        "phone": "9876543210",
        "name": "Asha",
        "event_raw": "",
        "page_url": "",
        "extra": {
          "n": "5"
        }
      }
    },
    {
      "name": "parse_4",
      "payload": {
        "number": "9876543210",
        "name": "",
        "full_name": "Fallback Name",
        "url": "https://u.com",
        "link": "https://l.com"
      },
      "expected": {
        "phone": "9876543210",
        "name": "Fallback Name",
        "event_raw": "",
        "page_url": "https://u.com",
        "extra": {}
      }
    },
    {
