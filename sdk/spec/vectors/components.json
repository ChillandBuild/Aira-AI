    {
      "name": "body_explicit_variables_with_fallback",
      "rule": {
        "variables": [
          {
            "source": "first_name",
            "fallback": "there"
          },
          {
            "source": "text",
            "value": "Order #42",
            "fallback": "-"
          },
          {
            "source": "extra",
            "key": " Plan ",
            "fallback": "basic"
          }
        ],
        "button_param": null
      },
      "template": {
        "name": "t",
        "language": "en",
        "body_text": "Hi {{1}}, {{2}} on {{3}}",
        "header_text": null,
        "header_media_type": null,
        "header_media_url": null,
        "buttons": []
      },
      "ctx": {
        "first_name": "Asha",
        "full_name": "Asha Rao",
        "page_url": "",
        "phone": "+919876543210",
        "extra": {
          "plan": "Gold"
        }
      },
      "expected_components": [
        {
          "type": "body",
          "parameters": [
            {
              "type": "text",
              "text": "Asha"
            },
            {
              "type": "text",
              "text": "Order #42"
            },
            {
              "type": "text",
              "text": "Gold"
            }
          ]
        }
      ]
    },
