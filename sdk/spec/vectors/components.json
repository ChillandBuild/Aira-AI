{
  "description": "build_components(template, rule, ctx) -> Meta template components. Generated from the backend.",
  "cases": [
    {
      "name": "body_two_vars_defaults",
      "rule": {
        "variables": null,
        "button_param": null
      },
      "template": {
        "name": "t",
        "language": "en",
        "body_text": "Hi {{1}}, your order {{2}} is confirmed.",
        "header_text": null,
        "header_media_type": null,
        "header_media_url": null,
        "buttons": []
      },
      "ctx": {
        "first_name": "Asha",
        "full_name": "Asha Rao",
        "page_url": "",
        "phone": "+919876543210",
        "extra": {}
      },
      "expected_components": [
        {
          "type": "body",
          "parameters": [
            {
              "type": "text",
              "text": "Asha"
            },
            {
              "type": "text",
              "text": "-"
            }
          ]
        }
      ]
    },
    {
