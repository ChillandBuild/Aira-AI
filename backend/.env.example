# Copy to backend/.env and fill in. See app/config.py for the authoritative field list.

# Supabase (critical — app fails to start without these)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Meta (WhatsApp/Instagram/Facebook) — meta_app_secret is critical: webhook signature
# verification rejects all inbound traffic without it (one shared Meta app, all tenants)
META_APP_SECRET=
META_APP_ID=
META_PAGE_TOKEN=
META_VERIFY_TOKEN=
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
TELEGRAM_BOT_TOKEN=

# Telecalling (TeleCMI)
TELECMI_USER_ID=
TELECMI_SECRET=
TELECMI_AGENT_PASSWORD=
TELECMI_CALLERID=
TELECMI_RECORDING_BASE_URL=

# AI providers — per-tenant only (configured in operator console app_settings), NOT
# read from env at runtime by AI code paths. Only useful here for local dev/testing.
GROQ_API_KEY=
SARVAM_API_KEY=
GEMINI_API_KEY=
JINA_API_KEY=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Misc
PUBLIC_BASE_URL=
SENTRY_DSN=
