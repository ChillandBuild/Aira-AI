<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/serverUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/server_url_hint"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/syncTokenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sync_token_hint"
        android:inputType="textPassword"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/saveConnectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_connect"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/permissionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/lastSyncedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/syncNowBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sync_now"
        android:layout_marginTop="16dp" />

</LinearLayout>